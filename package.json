{
  "name": "notification-preferences-service",
  "version": "1.0.0",
  "description": "Notification Preferences Service for managing user notification preferences",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --testPathPatterns=unit",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:all": "jest",
    "test:watch": "jest --watch --testPathPatterns=unit",
    "test:coverage": "jest --coverage --testPathPatterns=unit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "seed": "ts-node src/scripts/seed.ts",
    "example": "ts-node examples/usage-example.ts",
    "docker:build": "docker build -t notification-preferences-service .",
    "docker:run": "docker run -p 3000:3000 notification-preferences-service",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "keywords": [
    "notifications",
    "preferences",
    "typescript",
    "nodejs",
    "postgresql"
  ],
  "author": "Notification Preferences Service Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.17.0",
    "helmet": "^8.2.0",
    "jest": "^30.4.2",
    "morgan": "^1.10.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
